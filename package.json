{
  "name": "niall-utils",
  "version": "2.0.0",
  "description": "Small collection of my web utilities",
  "author": "eniallator",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eniallator/Niall-Utils.git"
  },
  "homepage": "https://github.com/eniallator/Niall-Utils",
  "bugs": {
    "url": "https://github.com/eniallator/Niall-Utils/issues"
  },
  "keywords": [
    "utilities",
    "typescript",
    "web-utils"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./encoding": {
      "types": "./dist/encoding/index.d.ts",
      "import": "./dist/encoding/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./functional": {
      "types": "./dist/functional/index.d.ts",
      "import": "./dist/functional/index.js"
    },
    "./math": {
      "types": "./dist/math/index.d.ts",
      "import": "./dist/math/index.js"
    },
    "./timing": {
      "types": "./dist/timing/index.d.ts",
      "import": "./dist/timing/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build": "tsc",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "findissues": "pnpm typecheck && pnpm lint && pnpm format:check",
    "bump-and-release": "./scripts/bump-and-release.sh",
    "release": "./scripts/release.sh",
    "publint": "publint run",
    "attw": "attw --pack .",
    "check-output": "./scripts/check-output.sh",
    "prepublish": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm test && pnpm publint && pnpm check-output"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@vitest/coverage-v8": "4.1.10",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "publint": "^0.3.23",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}

{
  "name": "niall-utils",
  "version": "4.0.0",
  "description": "Small collection of my web utilities",
  "author": "eniallator",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eniallator/Niall-Utils.git"
  },
  "homepage": "https://github.com/eniallator/Niall-Utils",
  "bugs": {
    "url": "https://github.com/eniallator/Niall-Utils/issues"
  },
  "keywords": [
    "utilities",
    "typescript",
    "web-utils"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./data": {
      "types": "./dist/data/index.d.ts",
      "import": "./dist/data/index.js"
    },
    "./encoding": {
      "types": "./dist/encoding/index.d.ts",
      "import": "./dist/encoding/index.js"
    },
    "./format": {
      "types": "./dist/format/index.d.ts",
      "import": "./dist/format/index.js"
    },
    "./functional": {
      "types": "./dist/functional/index.d.ts",
      "import": "./dist/functional/index.js"
    },
    "./math": {
      "types": "./dist/math/index.d.ts",
      "import": "./dist/math/index.js"
    },
    "./timing": {
      "types": "./dist/timing/index.d.ts",
      "import": "./dist/timing/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "build": "tsc",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "findissues": "pnpm typecheck && pnpm lint && pnpm format:check",
    "bump-and-release": "node scripts/bump-and-release.ts",
    "release": "node scripts/release.ts",
    "publint": "publint run",
    "attw": "attw --pack .",
    "check-output": "node scripts/check-output.ts",
    "prepublish": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm test && pnpm publint && pnpm check-output"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "tar": "^7.5.22",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
